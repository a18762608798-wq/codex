{
  "description": "Deny shared-project writes when the write lease belongs to another user.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|exec_command|shell|bash|write|edit|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/dell/.local/bin/project-lease-guard --format codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
